# Server
NODE_ENV=development
PORT=8787
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/spanish.db
# AI partner "Pablito" — Kimi / Moonshot (OpenAI-compatible). kimi-k2.7-code-highspeed
# is fast (~2-3s) and reasons lightly; use generous max_tokens (the server sends 1500)
# and read choices[].message.content. kimi-k2.6/k3 also work but are much slower (~15-19s).
AI_BASE_URL=https://api.moonshot.ai/v1
AI_API_KEY=your-kimi-moonshot-key
AI_MODEL=kimi-k2.7-code-highspeed
# Optional fallback AI provider (auto-used if the primary fails):
# AI_FALLBACK_BASE_URL=https://api.deepseek.com
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_MODEL=deepseek-chat
# Max paid Pablito calls per UTC day (cost cap); beyond it → offline practice mode.
AI_DAILY_CAP=40

# Player login PINs (keep the REAL ones out of source — set them here).
# If unset, the seed uses harmless placeholder PINs (111111 / 222222 / 333333).
PIN_FABIO=111111
PIN_ALEKS=222222
PIN_IGOR=333333
